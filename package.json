{
  "name": "punlisher",
  "version": "1.0.0",
  "bin": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"node --experimental-sqlite --require ts-node/register src/index.ts\"",
    "build": "tsc && cpy \"public/**/*\" dist/public",
    "start": "node dist/index.js",
    "gen-certs": "mkdir -p certs && openssl req -x509 -newkey rsa:2048 -keyout certs/server.key -out certs/server.crt -days 825 -nodes -subj '/CN=62.34.58.30' -addext 'subjectAltName=IP:62.34.58.30,IP:127.0.0.1,DNS:localhost'"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron": "^42.0.1",
    "electron-updater": "^6.8.3",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-fetch": "^3.3.2",
    "sharp": "^0.34.5",
    "sqlite3": "^6.0.1",
    "zxing-wasm": "^3.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.19.19",
    "cpy-cli": "^7.0.0",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
